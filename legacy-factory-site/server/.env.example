# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Configuration
JWT_SECRET=CHANGE_THIS_TO_RANDOM_SECRET_IN_PRODUCTION_MIN_32_CHARS
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Cookie Configuration
COOKIE_SECRET=CHANGE_THIS_TO_RANDOM_SECRET_IN_PRODUCTION_MIN_32_CHARS

# Database
DB_PATH=./database/daremon.db

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://daremon.nl

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_ROUNDS=12
